{
    "name": "pow",
    "version": "1.0.0",
    "description": "An ESM JavaScript Nintendo emulator with independent NES, SNES, N64, GB/GBC, GBA and NDS kernels and zero runtime package dependencies.",
    "type": "module",
    "main": "src/index.mjs",
    "exports": {
        ".": "./src/index.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:Leask/Pow.git"
    },
    "bugs": {
        "url": "https://github.com/Leask/Pow/issues"
    },
    "homepage": "https://github.com/Leask/Pow#readme",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "node src/cli/run-headless.mjs --rom ./Mario.nes --frames 120",
        "smoke": "node src/cli/run-headless.mjs --rom ./Mario.nes --frames 120",
        "smoke:snes": "node src/cli/run-headless.mjs --rom \"./Mario World.smc\" --frames 240 --strict-opcodes",
        "smoke:n64": "node src/cli/verify-n64.mjs",
        "smoke:gb": "node src/cli/verify-handhelds.mjs gb",
        "smoke:gba": "node src/cli/verify-handhelds.mjs gba",
        "smoke:nds": "node src/cli/verify-handhelds.mjs nds",
        "smoke:handhelds": "node src/cli/verify-handhelds.mjs all",
        "test": "node --test",
        "test:snes:long": "node --test test/snes-kernel.long-run.test.mjs",
        "gui": "PORT=8184 node src/cli/serve-gui.mjs"
    },
    "keywords": [
        "nes",
        "snes",
        "n64",
        "gb",
        "gbc",
        "gba",
        "nds",
        "emulator",
        "javascript",
        "headless"
    ],
    "author": "",
    "license": "MIT"
}
